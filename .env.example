# --- PostgreSQL (docker-compose.yml и docker-compose.local-db.yml) ---
# Для прод-подобного стека задайте надёжный пароль и те же логин/БД, что в DATABASE_URL.
POSTGRES_USER=verida
POSTGRES_PASSWORD=change_me
POSTGRES_DB=verida

# Порт проброса только для docker-compose.local-db.yml
LOCAL_DB_PORT=5432

# --- Приложение / Alembic (asyncpg) ---
# Локально (uvicorn + БД из local-db): хост localhost
DATABASE_URL=postgresql+asyncpg://verida:change_me@localhost:5432/verida

# Для полного стека (docker-compose.yml): хост БД — имя сервиса `db`
# DATABASE_URL=postgresql+asyncpg://verida:change_me@db:5432/verida
