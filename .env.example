# --- PostgreSQL (docker-compose.yml и docker-compose.local-db.yml) ---
# Для прод-подобного стека задайте надёжный пароль и те же логин/БД, что в DATABASE_URL.
POSTGRES_USER=verida
POSTGRES_PASSWORD=change_me
POSTGRES_DB=verida

# Порт проброса только для docker-compose.local-db.yml
LOCAL_DB_PORT=5432

# --- Приложение / Alembic (asyncpg) ---
# Локально (uvicorn + БД из local-db): хост localhost
DATABASE_URL=postgresql+asyncpg://verida:change_me@localhost:5432/verida

# Для полного стека (docker-compose.yml): хост БД — имя сервиса `db`
# DATABASE_URL=postgresql+asyncpg://verida:change_me@db:5432/verida

# JWT (HS256), минимум 32 символа
JWT_SECRET_KEY=dev-only-change-me-min-32-characters-long!!

# yandex gpt
YANDEX_GPT_FOLDER_ID=your_id
YANDEX_GPT_API_KEY=your_key
YANDEX_GPT_BASE_URL=https://rest-assistant.api.cloud.yandex.net/v1
YANDEX_GPT_MODEL=gpt://your_id/yandexgpt/rc

# Опционально: регион для web_search в Responses API (код региона Яндекса, напр. 213 — Москва).
# YANDEX_WEB_SEARCH_REGION=
# Опционально: только научные домены (PubMed, журналы, arXiv…); иначе поиск по всему интернету.
# YANDEX_WEB_SEARCH_ONLY_SCIENCE_DOMAINS=1

# Лимит «диалога» в токенах (оценка ~ len/3) для чата/конспекта; по умолчанию 14000.
# YANDEX_CHAT_MAX_DIALOGUE_TOKENS=14000
# Сколько вызовов web_search за один ответ Responses (по умолчанию 4).
# YANDEX_RESPONSES_MAX_TOOL_CALLS=4